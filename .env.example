# This lab's own settings file (owner, 2026-11-09): copy this file to .env beside docker-compose.yml, then chmod 600 .env.
#   cp .env.example .env && chmod 600 .env
# .env is git-ignored and docker-ignored. The host run reads it from the repo root (not the working directory); Docker reads it only through
# ${...} substitution for SHELF_URL, CAL_LAB_MODE and LAB_ALLOWED_HOSTS only (a missing .env is fine). Mock mode needs none of it. Placeholder values only below: never commit a real one.

# The mode a new workspace opens in: mock (default) or live (live also needs the shell opt-in below).
CAL_LAB_MODE=mock

# Extra host names the lab answers to, comma separated (the lab-proxy name). Empty: Docker uses its default from docker-compose.yml.
LAB_ALLOWED_HOSTS=

# Where the header "Shelf" button goes (the launcher). Leave empty to hide the button.
SHELF_URL=

# Live mode (owner only, identity provider only). The host run reads these four with util.parseEnv for live.js only and never copies them into the
# process environment. Docker stays Mock. PINGONE_REGION is com, eu, ca or asia (com if unset).
PINGONE_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000
PINGONE_REGION=com
PINGONE_CLIENT_ID=00000000-0000-0000-0000-000000000000
PINGONE_CLIENT_SECRET=replace-me

# Per-run shell settings, NOT read from this file (so the file cannot switch a guard on):
# PORT=5600                       # must be in 5600-5699 (Docker publishes 5603 by default)
# CALAB_BIND=127.0.0.1            # loopback only unless you set this on purpose (the container does)
# ALLOW_MOCK_SIGNIN=1             # the owner's opt-in to the mock persona sign-in (scripts/run.sh and Docker set it)
# IDP=mock                        # mock (default). Live needs IDP=pingone; anything else turns mock sign-in off.
# CAL_ALLOW_LIVE=1                # the owner's opt-in to SELECT live mode (with IDP=pingone)
# CAL_ENV_FILE=/path/to/other.env # tests and e2e only: read another file instead of this app's .env
# CAL_LIVE_TEST_BASE=http://127.0.0.1:<port>/<environment id>   # tests and e2e only: a fake PingOne on loopback
