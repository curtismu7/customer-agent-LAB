# This lab's own settings file (owner, 2026-11-09): copy this file to .env beside docker-compose.yml, then chmod 600 .env.
#   cp .env.example .env && chmod 600 .env
# .env is git-ignored and docker-ignored. The host run reads it from the repo root (not the working directory); Docker reads it only through
# ${...} substitution of the names docker-compose.yml lists (no env_file; a missing .env is fine). Mock mode needs none of it. Placeholder values only below: never commit a real one.

# The mode a new workspace opens in: mock (default) or live (live also needs the Real settings below).
CAL_LAB_MODE=mock

# Extra host names the lab answers to, comma separated (the lab-proxy name). Empty: Docker uses its default from docker-compose.yml.
LAB_ALLOWED_HOSTS=

# Where the header "Shelf" button goes (the launcher). Leave empty to hide the button.
SHELF_URL=

# Real mode (owner only). PINGONE_ENVIRONMENT_ID and PINGONE_REGION (com, eu, ca or asia; com if unset) are used by both Real paths below.
PINGONE_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000
PINGONE_REGION=com

# FULL Real (owner, 2026-11-10): a real sign-in (pi.flow, in the Sign in dialog), the agent's own token, an RFC 8693 token exchange and the Agent
# Gateway over MCP. Real is available when ALL of these are filled (and PINGONE_ENVIRONMENT_ID above). Once ANY of them is filled, the old
# PINGONE_CLIENT_* path below is ignored entirely. The demo user's PASSWORD is never stored here: the person types it in the Sign in dialog.
# The user app must list this redirect URI (pi.flow never redirects; PingOne only checks it): http://127.0.0.1:5603/callback (scripts/owner/pingone-real-setup.mjs registers it)
CAL_USER_CLIENT_ID=00000000-0000-0000-0000-000000000000
CAL_USER_CLIENT_SECRET=replace-me
CAL_AGENT_CLIENT_ID=00000000-0000-0000-0000-000000000000
CAL_AGENT_CLIENT_SECRET=replace-me
CAL_DEMO_USERNAME=demo.user@example.invalid
CAL_AGENT_GATEWAY_URL=https://agent-gateway.example/mcp
CAL_GATEWAY_AUDIENCE=replace-me
CAL_GATEWAY_SCOPE=replace-me
# Optional: the scope of the agent token and of token exchange 1 (the resource that owns it stamps act = the agent into the token). Leave it out for
# the default, agent:invoke. The owner setup script writes it here only when it is not the default.
# CAL_AGENT_SCOPE=agent:invoke

# OLD Real, identity provider only (two calls: discovery and a client-credentials token). Used ONLY while none of the CAL_* names above is filled.
# PINGONE_CLIENT_ID/SECRET are a worker client and are never used for the user or agent flow. Placeholders below count as not set.
PINGONE_CLIENT_ID=00000000-0000-0000-0000-000000000000
PINGONE_CLIENT_SECRET=replace-me

# Real OFF switch (Docker takes it from this file, the host run from the shell): 0 turns Real off even with the settings above.
# CAL_ALLOW_LIVE=0

# Per-run shell settings, NOT read from this file by the host run:
# PORT=5600                       # must be in 5600-5699 (Docker publishes 5603 by default)
# CALAB_BIND=127.0.0.1            # loopback only unless you set this on purpose (the container does)
# ALLOW_MOCK_SIGNIN=1             # the owner's opt-in to the mock persona sign-in (scripts/run.sh and Docker set it)
# IDP=                           # unset (default): Mock uses the mock IdP, Real uses PingOne. mock pins Mock; pingone pins Real (mock sign-in off).
# CAL_ENV_FILE=/path/to/other.env # tests and e2e only: read another file instead of this app's .env
# CAL_LIVE_TEST_BASE=http://127.0.0.1:<port>/<environment id>   # tests and e2e only: a fake PingOne on loopback
