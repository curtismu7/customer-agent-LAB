# This lab's own settings file (owner, 2026-11-09): copy this file to .env beside docker-compose.yml, then chmod 600 .env.
#   cp .env.example .env && chmod 600 .env
# .env is git-ignored and docker-ignored. The host run reads it from the repo root (not the working directory); Docker reads it only through
# ${...} substitution of the names docker-compose.yml lists (no env_file; a missing .env is fine). Mock mode needs none of it. Placeholder values only below: never commit a real one.

# The mode a new workspace opens in: mock (default) or live (live also needs the PingOne settings below).
CAL_LAB_MODE=mock

# Extra host names the lab answers to, comma separated (the lab-proxy name). Empty: Docker uses its default from docker-compose.yml.
LAB_ALLOWED_HOSTS=

# Where the header "Shelf" button goes (the launcher). Leave empty to hide the button.
SHELF_URL=

# Real / Live mode (owner only, identity provider only). Fill these four and Real is available, on the host and in Docker (no opt-in needed).
# The host run reads them with util.parseEnv for live.js only; Docker gets them by compose substitution and the server removes them from its
# environment at startup. PINGONE_REGION is com, eu, ca or asia (com if unset). Placeholders below count as not set.
PINGONE_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000
PINGONE_REGION=com
PINGONE_CLIENT_ID=00000000-0000-0000-0000-000000000000
PINGONE_CLIENT_SECRET=replace-me

# Real OFF switch (Docker takes it from this file, the host run from the shell): 0 turns Real off even with the settings above.
# CAL_ALLOW_LIVE=0

# Per-run shell settings, NOT read from this file by the host run:
# PORT=5600                       # must be in 5600-5699 (Docker publishes 5603 by default)
# CALAB_BIND=127.0.0.1            # loopback only unless you set this on purpose (the container does)
# ALLOW_MOCK_SIGNIN=1             # the owner's opt-in to the mock persona sign-in (scripts/run.sh and Docker set it)
# IDP=                           # unset (default): Mock uses the mock IdP, Real uses PingOne. mock pins Mock; pingone pins Real (mock sign-in off).
# CAL_ENV_FILE=/path/to/other.env # tests and e2e only: read another file instead of this app's .env
# CAL_LIVE_TEST_BASE=http://127.0.0.1:<port>/<environment id>   # tests and e2e only: a fake PingOne on loopback
